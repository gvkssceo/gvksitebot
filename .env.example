# ============== Email: choose one option ==============
# Copy to .env and set the values for your chosen option.

# --- Option 1: EmailJS (works on Render, use your service + templates + keys) ---
# Get these from https://dashboard.emailjs.com/
# Create 2 templates: one for "new application to GVKSS", one for "confirmation to applicant".
# In templates use variables: {{fullName}}, {{email}}, {{position}}, {{to_email}}, etc.
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_APPLICATION=template_id_for_application_to_gvkss
EMAILJS_TEMPLATE_CONFIRMATION=template_id_for_confirmation_to_applicant
EMAILJS_USER_ID=your_public_key
EMAILJS_PRIVATE_KEY=your_private_key

# --- Option 2: Resend (works on Render when SMTP is blocked) ---
SENDER_EMAIL=your@gmail.com
RESEND_API_KEY=re_xxxxxxxxxxxx

# --- Option 3: Gmail SMTP (local only; often blocked on Render free tier) ---
# SENDER_EMAIL=your@gmail.com
# GMAIL_APP_PASSWORD=your_16_char_app_password_here
